{
  "name": "limen",
  "version": "0.1.0",
  "description": "Your Claude Code usage limits, in the notch: an island that is invisible until you glance at it.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "usage": "node src/usage.js",
    "usage:line": "node src/usage.js --oneline",
    "spike": "electron src/spike.js",
    "test": "node test/paths.test.js && node test/notch.test.js && node test/trend.test.js && node test/prime.test.js && node test/config.test.js && node test/island-state.test.js && node test/viewmodel.test.js && node test/usage.test.js && node test/schedule.test.js && node test/alerts.test.js && node test/state.test.js",
    "dist": "electron-builder --mac",
    "dist:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -c.mac.identity=null -c.mac.notarize=false",
    "notarize": "bash scripts/notarize.sh"
  },
  "author": "bmo.dev",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.moobytes.limen",
    "productName": "Limen",
    "copyright": "\u00a9 2026 @billybowss",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": 1,
        "NSHumanReadableCopyright": "\u00a9 2026 @billybowss \u00b7 MIT"
      },
      "notarize": false
    },
    "dmg": {
      "title": "Limen ${version}",
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterSign": "scripts/afterSign.js"
  }
}
